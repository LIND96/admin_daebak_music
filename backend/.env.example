PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=admin_daebak_music
DB_SSLMODE=disable
JWT_SECRET=change-me-in-production-please
JWT_EXPIRY=1h
REFRESH_EXPIRY_ADMIN=24h
REFRESH_EXPIRY_CUSTOMER=2160h
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
BOOTSTRAP_SECRET=change-me-bootstrap-secret
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
# AI chat relay (POST /api/chat) — HANYA via 9Router. Relay mati (503) bila
# CHAT_PROVIDER_API_KEY kosong. Model TIDAK di-pin: backend mengambil daftar
# otomatis dari 9Router (GET /v1/models) lalu round-robin per request.
# Base URL tanpa trailing slash; untuk service compose: http://nine-router:20128/v1
CHAT_PROVIDER_BASE_URL=http://nine-router:20128/v1
CHAT_PROVIDER_API_KEY=
CHAT_TIMEOUT_SEC=45
# Shared secret mobiles must send as X-App-Secret. Empty = open (local dev only).
CHAT_APP_SECRET=
