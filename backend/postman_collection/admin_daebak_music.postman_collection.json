          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) { pm.collectionVariables.set('token', json.access_token); } else if (json.token) { pm.collectionVariables.set('token', json.token); }",
                  "if (json.refresh_token) { pm.collectionVariables.set('refreshToken', json.refresh_token); }",
                  "if (json.user && json.user.id) { pm.collectionVariables.set('userId', json.user.id); }"
                ]
